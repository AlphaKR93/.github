{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "composite": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*",
    "node_modules/@types/node/web-globals/fetch.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}